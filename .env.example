# APP_URL: The URL where this app is hosted (used to build shareable links).
APP_URL="MY_APP_URL"

# --- Share links (Copy Link / Paste link to decode, in QRMesh/SoundMesh/AirVault) ---
# Telegram bot used as free blob storage for shared payloads. Create a bot via
# @BotFather, add it as admin to a private channel, and use that channel's ID.
TELEGRAM_BOT_TOKEN="MY_BOT_TOKEN"
TELEGRAM_CHANNEL_ID="MY_CHANNEL_ID"
# Secret used to sign share links (HMAC). Falls back to TELEGRAM_BOT_TOKEN if unset —
# set your own so rotating the bot token doesn't break links already sent out.
SHARE_SECRET="MY_SHARE_SECRET"
